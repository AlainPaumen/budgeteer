[Unit]
Description=Budgeteer API
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/budgeteer
ExecStart=/usr/local/bin/bun run start
Restart=on-failure
RestartSec=5

# Environment
EnvironmentFile=/opt/budgeteer/.env

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/budgeteer/apps/api/data

[Install]
WantedBy=multi-user.target
