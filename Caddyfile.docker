# Budgeteer - Caddyfile for Docker Compose
# Replace localhost with your actual domain in production

http://localhost {
	root * /srv

	# Proxy API requests to Elysia backend
	handle /api/* {
		reverse_proxy api:3000
	}

	# Serve the built SPA with fallback to index.html
	handle {
		try_files {path} /index.html
		file_server
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Enable gzip compression
	encode gzip

	# Logging
	log {
		output file /var/log/caddy/budgeteer.log
	}
}
