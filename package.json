{
	"name": "budgeteer",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:web": "bun --filter web dev",
		"dev:api": "bun --filter api dev",
		"dev": "bun run dev:api & bun run dev:web",
		"build": "cd apps/web && bun run build",
		"start": "cd apps/api && bun run start",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"bun x biome check --write",
			"bash -c 'bun run --filter web typecheck'",
			"bash -c 'bun run --filter api typecheck'"
		],
		"apps/web/src/routeTree.gen.ts": []
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.6.23",
		"better-auth": "^1.6.23"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"api": "workspace:*",
		"better-sqlite3": "^12.11.1",
		"bun-types": "^1.3.14",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8"
	}
}
